# Copy this file to .env and adjust the values for your machine.
# Variables already set in the environment win over this file.
# Every variable is documented in docs/configuration.md.

# Application
APP_NAME=go-starter-kit
# One of: development, test, production
APP_ENV=development

# HTTP server
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# Must stay below HTTP_WRITE_TIMEOUT.
HTTP_REQUEST_TIMEOUT=15s
HTTP_BODY_LIMIT=1M
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
HTTP_TRUST_PROXY=false

# Comma-separated browser origins allowed to call the API. Empty: none.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database. Matches the PostgreSQL service of docker-compose.yml.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DB_CONNECT_TIMEOUT=5s
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=25
DB_CONNECTION_MAX_LIFETIME=30m
DB_CONNECTION_MAX_IDLE_TIME=5m
DB_SLOW_QUERY_THRESHOLD=200ms
# Apply pending migrations when the API starts.
DB_AUTO_MIGRATE=false

# Authentication
# bcrypt work factor, 4 to 16. Each step doubles the hashing time.
BCRYPT_COST=12
# Signs the access tokens. Required: at least 32 bytes, random, different in
# every environment, never committed. Generate one with: openssl rand -hex 32
# (64 hex characters, 32 random bytes).
JWT_SECRET=
# Written into every access token and checked when one is read.
JWT_ISSUER=go-starter-kit
# How long an access token stays valid.
ACCESS_TOKEN_LIFETIME=15m
# How long a refresh token stays valid. Must be longer than the access token.
REFRESH_TOKEN_LIFETIME=720h

# Logging
# One of: debug, info, warn, error
LOG_LEVEL=info
# One of: json, text
LOG_FORMAT=text

# Copy this file to .env and adjust the values for your machine.
# Variables already set in the environment win over this file.
# Every variable is documented in docs/configuration.md.

# Application
APP_NAME=go-starter-kit
# One of: development, test, production
APP_ENV=development

# HTTP server
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Logging
# One of: debug, info, warn, error
LOG_LEVEL=info
# One of: json, text
LOG_FORMAT=text
